# Copy to .env.local for local development. NEVER commit real keys you don't have to:
# the anon key is public by design (it ships in the browser), the service_role key must never appear here.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional
VITE_APP_NAME=Jastip China Desk
VITE_ENV_LABEL=              # e.g. Sandbox  (shows a chip next to the title)
VITE_ENABLE_GOOGLE=false     # true = show "Continue with Google" on sign-in and sign-up (README: "Google sign-in")
VITE_PUBLIC_MODE=false       # true = no login at all, anyone with the link can edit (run migration 0002 too)
VITE_DEMO=false              # true = local-only demo data in the browser, no Supabase needed
